    BossTab.Halloween.Data.Generation = BossTab.Halloween.Data.Generation + 1 	
    if not state then 		
        BossTab.Halloween.Data.Target = nil 		
        BossTab.Halloween.Data.Phase = "Waiting" 		
        BossTab.Halloween.StatusLabel:SetText("Status: Disabled") 		
        return 	end 	
    runtime:Spawn(function(generation, model, health, maxHealth, hitbox) 		
        while BossTab.Halloween.Data.Running and BossTab.Halloween.Data.Generation == generation do 			
            pcall(function() 				
                model, health, maxHealth, hitbox = BossTab.Halloween.findActiveBoss(true) 				
                if model then 					
                    if BossTab.Halloween.Data.Target ~= model then 						
                        BossTab.Halloween.Data.Target = model 					end 					
                    BossTab.Halloween.Data.Phase = "Fighting" 					
                    if lp.player.Character 						and lp.player.Character:FindFirstChildOfClass("Humanoid") 						and lp.player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then 						
                        BossTab.Halloween.StatusLabel:SetText("Status: Fighting") 						
                        BossTab.attack(BossTab.Halloween, model, health, maxHealth, hitbox) 					
                    else 						
                        BossTab.Halloween.StatusLabel:SetText("Status: Waiting for Respawn") 					end 				
                else 					
                    BossTab.Halloween.Data.Target = nil 					
                    BossTab.Halloween.Data.Phase = "Waiting" 					
                    BossTab.Halloween.StatusLabel:SetText("Status: Waiting for Halloween Boss") 				end 			
            end) 			
            task.wait(model and 0.01 or 0.4) 		
        end 	end, BossTab.Halloween.Data.Generation) 
end)

