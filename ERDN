    if not model then 		
        BossTab.runtime.events = workspace:FindFirstChild("Events") 		
        BossTab.runtime.bossFolder = BossTab.runtime.events and (BossTab.runtime.events:FindFirstChild("BossEvent") or BossTab.runtime.events:FindFirstChild("BossArena")) 		
        if BossTab.runtime.bossFolder then 			
            for _, candidate in ipairs(BossTab.runtime.bossFolder:GetDescendants()) do 				
                if candidate:IsA("Model") and (candidate:FindFirstChild("BossDamageHitbox") or candidate:HasTag("BossEventBoss")) then 					
                    model = candidate 					
