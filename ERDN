BossTab.formatCountdown = function(seconds, hours, minutes) 	
    seconds = math.max(0, math.floor(seconds or 0)) 	
    hours = math.floor(seconds / 3600) 	
    minutes = math.floor(seconds % 3600 / 60) 	
    seconds = seconds % 60 	
    return string.format("%dh %dmin %ds", hours, minutes, seconds) 
end 

BossTab.getBossHeadPosition = function(model, hitbox, head) 	
    head = model:FindFirstChild("Head", true) or model:FindFirstChild("head", true) 	
    if head and head:IsA("BasePart") then return head.Position end 	
    if head and head:IsA("Bone") then return head.WorldPosition end 	
    return hitbox.Position + Vector3.new(0, hitbox.Size.Y * 0.35, 0) 
end 

BossTab.getAliveCharacter = function(generation, timeout, startedAt, character, root, humanoid) 	
    if not BossTab.Data.Running or BossTab.Data.Generation ~= generation then return end 	
    startedAt = os.clock() 	
    repeat 		
        character = lp.player.Character 		
        root = character and character:FindFirstChild("HumanoidRootPart") 		
        humanoid = character and character:FindFirstChildOfClass("Humanoid") 		
        if root and humanoid and humanoid.Health > 0 then 			
            return character, root, humanoid 		
        end 		
        BossTab.StatusLabel:SetText("Status: Waiting for Respawn") 		
        task.wait(0.15) 	
    until not BossTab.Data.Running 		or BossTab.Data.Generation ~= generation 		or (timeout and os.clock() - startedAt >= timeout) 
end 

BossTab.attack = function(boss, model, health, maxHealth, hitbox, character, root, humanoid, punch, leftHand, rightHand, headPos) 	
    character = LP.Character 	
    root = character and character:FindFirstChild("HumanoidRootPart") 	
    humanoid = character and character:FindFirstChildOfClass("Humanoid") 	
    if not root or not humanoid or humanoid.Health <= 0 then return end 	
    
    local backpack = LP:FindFirstChild("Backpack")
    punch = character:FindFirstChild("Punch") or backpack and backpack:FindFirstChild("Punch")
    if punch and punch.Parent == backpack then
        humanoid:EquipTool(punch)
    end
    
    headPos = BossTab.getBossHeadPosition(model, hitbox)
    local targetPos = headPos + Vector3.new(0, 35, 0)
    root.CFrame = CFrame.lookAt(targetPos, headPos)
    root.AssemblyLinearVelocity = Vector3.zero 	
    root.AssemblyAngularVelocity = Vector3.zero 	
    
    leftHand = character:FindFirstChild("LeftHand") 	
    rightHand = character:FindFirstChild("RightHand") 	
    
    pcall(function() 		
        if rightHand and leftHand and hitbox then 			
            firetouchinterest(hitbox, rightHand, 0) 			
            firetouchinterest(hitbox, rightHand, 1) 			
            firetouchinterest(hitbox, leftHand, 0) 			
            firetouchinterest(hitbox, leftHand, 1) 		
        end 	end) 	
            
    if os.clock() - boss.Data.LastPunch >= boss.Data.PunchInterval then 		
        boss.Data.LastPunch = os.clock() 		
        pcall(function() 			
            if LP:FindFirstChild("muscleEvent") then
                LP.muscleEvent:FireServer("punch", "leftHand") 			
                LP.muscleEvent:FireServer("punch", "rightHand") 			
            end
            if punch and punch.Parent == character then 
                punch:Activate() 
            end 		end) 	end 	
            
    BossTab.BossLabel:SetText((boss.BossLabelPrefix or "Boss: ") .. BossTab.getBossDisplayName(model)) 	
    BossTab.runtime.health = BossTab.getBossHealth(health, model) 	
    BossTab.runtime.maxHealth = BossTab.getBossMaxHealth(maxHealth, model) 	
    BossTab.HealthLabel:SetText("Health: " .. formatCurrentStat(BossTab.runtime.health) .. " / " .. formatCurrentStat(BossTab.runtime.maxHealth)) 
end 

BossTab.findChest = function(chest, prompt, part) 	
    for _, candidate in ipairs(services.collectionservice:GetTagged("BossEventChest")) do 		
        if candidate:IsDescendantOf(workspace) then chest = candidate break end 	end 	
    if not chest then chest = workspace:FindFirstChild("BossChest", true) end 	
    if not chest then 		
        for _, candidate in ipairs(workspace:GetDescendants()) do 			
            if candidate:IsA("ProximityPrompt") and candidate.Name == "bossChestPrompt" then 				
                chest = candidate.Parent 				
                break 			
            end 		end 	end 	
    if not chest then return end 	
    prompt = chest:FindFirstChild("bossChestPrompt", true) 	
    part = prompt and prompt.Parent or (chest:IsA("Model") and (chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart", true))) or chest 	
    if part and part:IsA("BasePart") then return chest, prompt, part end 
end 

BossTab.collectChest = function(generation, startedAt, chest, prompt, part, character, root) 	
    BossTab.StatusLabel:SetText("Status: Waiting for Chest") 	
    startedAt = os.clock() 	
    repeat 		
        chest, prompt, part = BossTab.findChest() 		
        if chest and chest:GetAttribute("BossChestEmerging") ~= true then break end 		
        task.wait(0.15) 	
    until not BossTab.Data.Running or BossTab.Data.Generation ~= generation or os.clock() - startedAt >= 12 	
    if not BossTab.Data.Running or BossTab.Data.Generation ~= generation or not chest or not part then return end 	
    BossTab.StatusLabel:SetText("Status: Collecting Chest") 	
    startedAt = os.clock() 	
    repeat 		
        character, root = BossTab.getAliveCharacter(generation, 2) 		
        if character and root and chest.Parent and part.Parent then 			
            BossTab.StatusLabel:SetText("Status: Collecting Chest") 			
            pcall(function() 				
                root.CFrame = CFrame.lookAt(part.Position + Vector3.new(0, 3, 4), part.Position) 				
                root.AssemblyLinearVelocity = Vector3.zero 			end) 			
            task.wait(0.2) 			
            if not BossTab.Data.Running or BossTab.Data.Generation ~= generation then return end 			
            if not (prompt and prompt.Parent and type(fireproximityprompt) == "function" 				and pcall(fireproximityprompt, prompt)) then 				
                pcall(function() 					
                    services.virtualinputmanager:SendKeyEvent(true, Enum.KeyCode.E, false, game) 					
                    task.wait(0.1) 					
                    services.virtualinputmanager:SendKeyEvent(false, Enum.KeyCode.E, false, game) 				end) 			
            end 		end 		
        task.wait(0.3) 	
    until not BossTab.Data.Running 		or BossTab.Data.Generation ~= generation 		or lp.player:GetAttribute("BossChestPending") == false 		or not chest.Parent 		or os.clock() - startedAt >= 12 
end 

