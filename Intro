-- ================= AMBIENTE MASIVO DE EMOJIS (CINEMÁTICO) =================
local emojis = {"🎃", "👻", "🦇", "🕷️", "💀", "🕯️", "🕸️", "🍬", "🧙", "🔮", "🍫", "👁️"}
local totalEmojis = 45 -- Aumentado a 45 emojis flotantes[span_1](start_span)[span_1](end_span)

for i = 1, totalEmojis do
    task.spawn(function()
        local emojiLabel = Instance.new("TextLabel")
        emojiLabel.Size = UDim2.new(0, 40, 0, 40)
        
        local randomX = math.random(2, 98) / 100
        emojiLabel.Position = UDim2.new(randomX, 0, 1.2, 0)
        
        emojiLabel.BackgroundTransparency = 1
        emojiLabel.Text = emojis[math.random(1, #emojis)]
        emojiLabel.TextSize = math.random(22, 38)
        emojiLabel.TextTransparency = math.random(5, 8) / 10 -- Transparencia sutil para efecto de profundidad
        emojiLabel.ZIndex = math.random(1, 5) -- Siempre detrás del texto principal
        emojiLabel.Parent = IntroBackground
        
        local randomSpeed = math.random(30, 48) / 10 -- Subida lenta estilo cine
        local targetY = -0.2
        local rotationSpeed = math.random(-60, 60)
        local waveFrequency = math.random(3, 7)
        local waveAmplitude = math.random(10, 25)
        
        local startTime = tick()
        local connection
        connection = RunService.RenderStepped:Connect(function()
            local elapsed = tick() - startTime
            local progress = elapsed / randomSpeed
            
            if progress >= 1 or not IntroGui.Parent then
                connection:Disconnect()
                emojiLabel:Destroy()
                return
            end
            
            local currentY = 1.2 + (targetY - 1.2) * progress
            local offsetX = math.sin(progress * waveFrequency) * waveAmplitude
            
            emojiLabel.Position = UDim2.new(randomX, offsetX, currentY, 0)
            emojiLabel.Rotation = rotationSpeed * progress
        end)
    end)
    task.wait(0.08) -- Salen rápidamente uno tras otro para llenar la pantalla[span_2](start_span)[span_2](end_span)
end

-- Tiempo total en pantalla
