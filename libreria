    function WindowObj:CreateTab(name)
        local btn = Create("TextButton", {
            Name = name .. "TabBtn",
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Color3.fromRGB(6, 16, 32),
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
            Text = name,
            TextColor3 = Color3.fromRGB(150, 185, 220),
            Font = Enum.Font.GothamSemibold,
            TextSize = 11,
            AutoButtonColor = false,
            ZIndex = 7
        }, NavContainer)
        Create("UICorner", {CornerRadius = UDim.new(0, 10)}, btn)

        local page = Create("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(0, 180, 255),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false,
            ZIndex = 7
        }, ContentContainer)

        local pageLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, page)

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
        end)

        table.insert(navButtons, {Button = btn, Page = page})

        if firstTab then
            firstTab = false
            page.Visible = true
            btn.BackgroundTransparency = 0.2
            btn.TextColor3 = Color3.fromRGB(0, 225, 255)
        end

        btn.MouseButton1Click:Connect(function()
            for _, p in pairs(pages) do p.Visible = false end
            page.Visible = true

            for _, nav in ipairs(navButtons) do
                nav.Button.BackgroundTransparency = 0.6
                nav.Button.TextColor3 = Color3.fromRGB(150, 185, 220)
            end

            btn.BackgroundTransparency = 0.2
            btn.TextColor3 = Color3.fromRGB(0, 225, 255)
        end)

        pages[name] = page

        local TabMethods = {}

        function TabMethods:AddToggle(config, callback)
            local titleText = config.Name or "Toggle"
            local currentState = config.Default or false

            local row = Create("Frame", {
                Size = UDim2.new(1, -6, 0, 36),
                BackgroundColor3 = Color3.fromRGB(5, 14, 28),
                BackgroundTransparency = 0.4,
                BorderSizePixel = 0,
                ZIndex = 8
            }, page)
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}, row)

            Create("TextLabel", {
                Size = UDim2.new(1, -50, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = titleText,
                TextColor3 = Color3.fromRGB(230, 240, 255),
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 8
            }, row)

            local switchBg = Create("TextButton", {
                Size = UDim2.new(0, 34, 0, 18),
                Position = UDim2.new(1, -40, 0.5, -9),
                BackgroundColor3 = currentState and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(18, 28, 42),
                Text = "",
                AutoButtonColor = false,
                ZIndex = 8
            }, row)
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}, switchBg)

            local knob = Create("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = currentState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0,
                ZIndex = 8
            }, switchBg)
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

            switchBg.MouseButton1Click:Connect(function()
                currentState = not currentState
                local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                if currentState then
                    TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(0, 180, 255)}):Play()
                    TweenService:Create(knob, tweenInfo, {Position = UDim2.new(1, -16, 0.5, -7)}):Play()
                else
                    TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(18, 28, 42)}):Play()
                    TweenService:Create(knob, tweenInfo, {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
                end
                pcall(callback, currentState)
            end)

            if currentState then pcall(callback, true) end
            return row
        end

        function TabMethods:AddButton(text, callback)
            local btnElem = Create("TextButton", {
                Size = UDim2.new(1, -6, 0, 32),
                BackgroundColor3 = Color3.fromRGB(6, 18, 36),
                BackgroundTransparency = 0.4,
                Text = text,
                TextColor3 = Color3.fromRGB(0, 225, 255),
                TextSize = 11,
                Font = Enum.Font.GothamSemibold,
                AutoButtonColor = false,
                ZIndex = 8
            }, page)
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}, btnElem)

            btnElem.MouseButton1Click:Connect(function()
                pcall(callback)
            end)
            return btnElem
        end

        return TabMethods
    end

    return WindowObj
end

