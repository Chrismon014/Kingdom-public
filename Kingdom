local strengthWorker = {
	running = false,
	workerActive = false,
	sendRate = 500,
	maxBurst = 24,
	Tokens = 0,
	LastAt = os.clock()
}

local function sendTrainingReps(state, rate, maxBurst, canSend)
	local now = os.clock()
	local elapsed = math.clamp(now - (state.LastAt or now), 0, 0.1)
	state.LastAt = now
	state.Tokens = math.min(maxBurst, (state.Tokens or 0) + rate * elapsed)
	local sent = 0
	while state.Tokens >= 1 and canSend() do
		muscleEvent:FireServer("rep")
		state.Tokens = state.Tokens - 1
		sent = sent + 1
	end
	return sent
end

local function startStrengthWorker()
	if strengthWorker.workerActive then return end
	strengthWorker.workerActive = true
	task.spawn(function()
		strengthWorker.LastAt = os.clock()
		while strengthWorker.running do
			sendTrainingReps(strengthWorker, strengthWorker.sendRate, strengthWorker.maxBurst, function()
				return strengthWorker.running
			end)
			RunService.Heartbeat:Wait()
		end
		strengthWorker.workerActive = false
	end)
end

local function setStrengthSpeed(rate, name, state)
	strengthWorker.sendRate = rate
	strengthWorker.running = state
	strengthWorker.Tokens = 0
	if state then
		print("[Silence Engine] Activado: " .. name .. " (" .. rate .. " reps/s)")
		startStrengthWorker()
	else
		print("[Silence Engine] Desactivado")
	end
end

